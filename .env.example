# ============================================================================
# Calolean — Environment Variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Mirror every value in Vercel -> Project -> Settings -> Environment Variables.
# Phases refer to PRODUCTION_UPGRADE.md.
# ============================================================================

# ── Firebase client SDK (existing) ──────────────────────────────────────────
# Firebase console -> Project settings -> General -> Your apps -> Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (server) — Phase 1 ───────────────────────────────────
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key, then base64-encode the whole JSON file:
#   base64 -w0 service-account.json   (macOS: base64 -i service-account.json)
FIREBASE_SERVICE_ACCOUNT_B64=

# ── Google Cloud / Vertex AI — Phase 3 ───────────────────────────────────────
# GCP console -> IAM -> Service accounts. Needs roles/aiplatform.user
# (and roles/cloudsql.client for Phase 4 — may be the same SA as Firebase).
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_B64=
VERTEX_LOCATION=global
# Dev-only fallback: if GCP_* is unset, the app uses this Gemini API key
# (aistudio.google.com/apikey) instead of Vertex AI.
GOOGLE_API_KEY=
# Model IDs are config, not code. Vision/scan/form uses the cost-optimized
# flash-lite (GA id — the preview id is discontinued 2026-07-09).
GEMINI_CHAT_MODEL=gemini-3.1-flash
GEMINI_VISION_MODEL=gemini-3.1-flash-lite

# ── Cloud SQL (PostgreSQL reference DBs) — Phase 4 ───────────────────────────
# GCP console -> Cloud SQL -> instance Overview -> "Connection name"
# (format project:region:instance)
CLOUD_SQL_CONNECTION_NAME=
CLOUD_SQL_DB=calolean
CLOUD_SQL_USER=
CLOUD_SQL_PASSWORD=

# ── Nutrition fallback APIs (existing) ───────────────────────────────────────
# Free key: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# ── Ads & monetization — Phases 5 + 7 ────────────────────────────────────────
# AdSense -> Account -> Account information (ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# AdSense -> Ads -> By ad unit -> In-article (native) -> data-ad-slot id
NEXT_PUBLIC_ADSENSE_SLOT_NATIVE=
# Amazon Associates -> your tracking tag (e.g. calolean-21)
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=

# ── Google Health API (steps) — Phase 9 ──────────────────────────────────────
# GCP console -> APIs & Services -> Credentials -> OAuth 2.0 Web client
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=https://calolean.com/api/health/callback
# Optional overrides (defaults match developers.google.com/health docs)
# GOOGLE_HEALTH_SCOPES=
# GOOGLE_HEALTH_API_BASE=
# 32-byte hex key for AES-GCM encryption of stored refresh tokens:
#   openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ── Analytics & app — Phase 10 ───────────────────────────────────────────────
# Google Analytics -> Admin -> Data streams -> Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_APP_URL=https://calolean.com
