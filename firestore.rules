rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users own their subtree…
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /foodLogs/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /workoutLogs/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /formAnalyses/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /days/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // …except usage counters, which only the Admin SDK may write.
      match /usage/{dateKey} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Subscription + health tokens: Admin SDK only, never client-accessible.
    match /private/{uid} {
      allow read, write: if false;
    }
  }
}
