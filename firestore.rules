rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users own their subtree…
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /foodLogs/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /workoutLogs/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /formAnalyses/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /days/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // …except usage counters, which only the Admin SDK may write.
      match /usage/{dateKey} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // Any other user-owned subcollection (conversations, scanHistory, …) is
      // the user's own data. `usage` is excluded so its admin-only rule wins.
      match /{sub}/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid == uid
          && sub != 'usage';
      }
    }

    // Shared chat snapshots. Deliberately world-readable — an unguessable id
    // IS the capability, the same model ChatGPT/Claude share links use. Only
    // the signed-in owner can publish one, and only they can revoke it.
    match /shares/{shareId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.owner_uid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.owner_uid == request.auth.uid;
    }

    // Subscription + health tokens: Admin SDK only, never client-accessible.
    match /private/{uid} {
      allow read, write: if false;
    }
  }
}
